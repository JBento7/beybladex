generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

model ArenaLayout {
  id        String   @id @default(cuid())
  key       String   @unique // "scoreboard" | "winner"
  data      String   // JSON of Record<fieldKey, {x,y,w?,h?,fs?}>
  updatedAt DateTime @default(now()) @updatedAt
}

enum TournamentFormat {
  ROUND_ROBIN
  GROUPS
  SINGLE_ELIMINATION
  SWISS
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  FINISHED
}

enum FinishType {
  SPIN_FINISH
  OVER_FINISH
  BURST_FINISH
  EXTREME_FINISH
  MISSLAUNCH
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum DeckType {
  SOLO
  THREE_ON_THREE
  THREE_ON_THREE_PLUS_ONE // 4 registered, 3 active per match (lib/deckFormat)
}

enum SetStatus {
  IN_PROGRESS
  FINISHED
}

enum AnnouncementType {
  NEWS
  POLL
}

enum PollType {
  TEXT
  CHECKBOX
}

enum BeyPartLine {
  BX
  UX
  CX
  RATCHET
  BIT
  BX_EXPAND
  UX_EXPAND
  CX_EXPAND
}

enum BeyPartCategory {
  BLADE
  RATCHET
  BIT
  LOCK_CHIP
  MAIN_BLADE
  ASSIST_BLADE
  OVER_BLADE
}

// A league/community using the app (LBL Londrina, LBM Maringá, ...). Each
// tournament belongs to one host community; the rankings are filters over it.
model Community {
  id        String   @id @default(cuid())
  slug      String   @unique // "lbl", "lbm"
  name      String
  city      String?
  logoUrl   String?
  color     String?
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(PARTICIPANT)
  beyblade      String?
  avatarUrl     String?
  deleted       Boolean  @default(false)
  isGuest       Boolean  @default(false)
  bladerName    String?
  canJudge      Boolean  @default(false)
  // Admin scope: null = every community (original LBL organizers); "lbm" = only LBM.
  adminCommunity String?
  // Community the player belongs to (badge/filter only — rankings follow the tournament).
  homeCommunity  String? @default("lbl")
  featuredBey1  String?
  featuredBey2  String?
  featuredBey3  String?
  createdAt     DateTime @default(now())

  organizedTournaments Tournament[]           @relation("OrganizerTournaments")
  participations       TournamentParticipant[]
  matchesAsPlayer1     Match[]                @relation("Player1Matches")
  matchesAsPlayer2     Match[]                @relation("Player2Matches")
  wonMatches           Match[]                @relation("WinnerMatches")
  judgedMatches        Match[]                @relation("JudgeMatches")
  judgingTournaments   TournamentJudge[]
  matchPoints          MatchPoint[]
  createdInvites       OrganizerInvite[]      @relation("InviteCreator")
  beyblades            Beyblade[]
  wonSets              MatchSet[]             @relation("SetWinner")
  resetTokens          PasswordResetToken[]
  emailVerifyTokens    EmailVerifyToken[]
  emailVerified        Boolean  @default(false)
  announcements        Announcement[]   @relation("AnnouncementCreator")
  pollResponses        PollResponse[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model OrganizerInvite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  createdBy String
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  creator User @relation("InviteCreator", fields: [createdBy], references: [id])
}

model Tournament {
  id              String           @id @default(cuid())
  name            String
  description     String?
  format          TournamentFormat
  status          TournamentStatus @default(DRAFT)
  organizerId     String
  maxParticipants Int?
  startDate       DateTime?
  deckType        DeckType         @default(SOLO)
  prize           String?
  arenas          Int?    @default(1)
  isOfficial      Boolean @default(true)
  isTest          Boolean @default(false)
  // Host community (Community.slug). Decides which community ranking it feeds.
  communitySlug   String  @default("lbl")
  // Partnership event between communities: counts ONLY in the shared ranking.
  isPartnership   Boolean @default(false)
  // "Pontuação dobrada" (official events only): placement points × 2.
  doubleRankingPoints Boolean @default(false)
  // Points per placement (base, before "Pontuação dobrada") frozen at the first
  // finalization, so later recalculations never use newer rules. Null = not
  // finalized yet (or finalized before this existed: the default table).
  rankingPointsTable Json?
  // Suíço: number of Swiss rounds, frozen when first needed so approving or
  // removing a player mid-event can't move the Swiss/knockout boundary.
  swissRounds     Int?
  // Swiss rules version used by this event (set when it starts). A later rule
  // change never silently reorders a finished event.
  rulesVersion    String?
  // Who may score matches when no judge is assigned. "RESTRICTED" (default):
  // admins, the BeyEncontro organizer, judges. "OPEN_PARTICIPANTS": also the
  // event's approved participants — explicit opt-in, never for official events.
  judgingMode     String  @default("RESTRICTED")
  // Monotonic version of everything a live page shows (sign-ups, matches,
  // points, status…). Bumped in the same transaction as each change, so the
  // polling endpoint reads one integer instead of hashing the history.
  stateVersion    Int     @default(0)
  setsToWin       Int     @default(2)
  pointsToWinSet  Int     @default(4)
  qualifiers      Int?    // Suíço: how many top players advance to the knockout (16/8/4)
  isMultiDay      Boolean @default(false) // 2-day tournament: day 1 Suíço, day 2 mata-mata
  day2Date        DateTime? // date of the knockout day (day 2)
  day2SetsToWin   Int?    // 2-day: match rules for the knockout day (day 1 uses setsToWin)
  day2PointsToWinSet Int? // 2-day: points per set for the knockout day
  bannerUrl       String?
  location        String?
  venueName       String?
  address         String?
  entryFee        Float?
  regulation      String?
  registrationDeadline DateTime?
  createdAt       DateTime         @default(now())

  organizer       User                   @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  participants    TournamentParticipant[]
  groups          Group[]
  matches         Match[]
  judges          TournamentJudge[]
  beybladeRecords BeybladeMatchRecord[]
  roundLogs       SwissRoundLog[]
  adminActions    TournamentAdminAction[]

  @@index([communitySlug]) // created by /api/migrate since the leagues split; declared so migrations and schema agree
}

model TournamentJudge {
  id           String @id @default(cuid())
  tournamentId String
  userId       String

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  groupId      String?
  totalPoints  Int      @default(0)
  rankingPoints Int     @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  placement    Int?
  beyblade1    String?
  beyblade2    String?
  beyblade3    String?
  beyblade4    String?  // 3on3 + 1 reserva only
  // Composition of the registered deck AS REGISTERED (name + parts per bey,
  // with the original id for stats). Later profile edits don't change it.
  deckSnapshot   Json?
  deckSnapshotAt DateTime?
  hasPaid            Boolean  @default(false)
  beybladeInspected  Boolean  @default(false)
  approved           Boolean  @default(true) // paid tournaments start false (awaiting admin approval)
  finalsSwapUsed     Boolean  @default(false) // Suíço: used their 1 deck change for the knockout
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  group      Group?     @relation(fields: [groupId], references: [id])

  @@unique([tournamentId, userId])
  @@index([userId])
}

model Group {
  id           String @id @default(cuid())
  tournamentId String
  name         String

  tournament   Tournament             @relation(fields: [tournamentId], references: [id])
  participants TournamentParticipant[]
  matches      Match[]
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  player1Id    String
  player2Id    String
  winnerId     String?
  groupId      String?
  judgeId      String?
  round        Int
  bracketPos   Int?
  arena        Int?
  slot         Int?
  status       MatchStatus @default(PENDING)
  isWalkover   Boolean     @default(false)
  isThirdPlace Boolean     @default(false)
  countdownAt  DateTime?
  countdownKey String?
  finishVideoAt   DateTime? // signals the telão to play a finish-type video
  finishVideoType String?
  onAirAt      DateTime?
  xSidePlayerId String?  // which player chose the X side of the stadium (other = B side)
  setsToWin      Int?    // per-match override (e.g. 2-day: knockout uses different rules)
  pointsToWinSet Int?    // per-match override
  // Bumped by every change of the score (point, undo, W.O.) in the same
  // transaction: judge panel and telão use it to drop out-of-order updates.
  scoreVersion Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  tournament     Tournament            @relation(fields: [tournamentId], references: [id])
  player1        User                  @relation("Player1Matches", fields: [player1Id], references: [id])
  player2        User                  @relation("Player2Matches", fields: [player2Id], references: [id])
  winner         User?                 @relation("WinnerMatches", fields: [winnerId], references: [id])
  judge          User?                 @relation("JudgeMatches", fields: [judgeId], references: [id])
  group          Group?                @relation(fields: [groupId], references: [id])
  points         MatchPoint[]
  sets           MatchSet[]
  beybladeRecords BeybladeMatchRecord[]
  deckOrders     MatchDeckOrder[]
  trioSelections MatchTrioSelection[]
  participations RoundParticipation[]

  @@index([tournamentId, round])
  @@index([tournamentId, status, arena])
  @@index([player1Id])
  @@index([player2Id])
  @@index([judgeId])
}

model MatchSet {
  id            String    @id @default(cuid())
  matchId       String
  setNumber     Int
  player1Points Int       @default(0)
  player2Points Int       @default(0)
  winnerId      String?
  status        SetStatus @default(IN_PROGRESS)
  createdAt     DateTime  @default(now())

  match   Match        @relation(fields: [matchId], references: [id])
  winner  User?        @relation("SetWinner", fields: [winnerId], references: [id])
  points  MatchPoint[]

  @@index([matchId])
}

model MatchPoint {
  id           String     @id @default(cuid())
  matchId      String
  userId       String
  finishType   FinishType
  points       Int
  beybladeUsed String?
  beybladeId   String?
  setId        String?
  // Idempotency key sent by the scoring screen: the same action (retry,
  // double tap, second device replaying it) is stored only once.
  actionId     String?
  createdAt    DateTime   @default(now())

  match     Match     @relation(fields: [matchId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  beyblade  Beyblade? @relation(fields: [beybladeId], references: [id])
  set       MatchSet? @relation(fields: [setId], references: [id])

  @@unique([matchId, actionId])
  @@index([matchId])
  @@index([setId])
  @@index([userId])
  @@index([beybladeId])
}

// 3on3 + 1 reserva: the 3 active Beyblades a player uses in ONE match (the
// 4th registered one is the reserve). Revisable until the match is locked
// (first "Iniciar" or first point, under the match row lock); then frozen
// with a snapshot. History of who changed it lives in MatchAuditLog.
model MatchTrioSelection {
  id             String    @id @default(cuid())
  matchId        String
  tournamentId   String
  userId         String
  bey1Id         String
  bey2Id         String
  bey3Id         String
  reserveId      String?
  revision       Int       @default(1)
  confirmedAt    DateTime
  confirmedById  String
  lockedAt       DateTime?
  lockedSnapshot Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([tournamentId, userId])
}

model MatchDeckOrder {
  id         String   @id @default(cuid())
  matchId    String
  setNumber  Int
  userId     String
  cycleIndex Int
  bey1Id     String
  bey2Id     String
  bey3Id     String
  createdAt  DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@unique([matchId, userId, setNumber, cycleIndex])
}

model Beyblade {
  id          String   @id @default(cuid())
  userId      String
  name        String
  beyLine     String?
  blade       String?
  ratchet     String?
  bit         String?
  lockChip    String?
  metalBlade  String?
  assistBlade String?
  overBlade   String?
  model       String?
  wins        Int      @default(0)
  losses      Int      @default(0)
  hiddenFromCommunity Boolean @default(false)
  createdAt   DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id])
  matchPoints  MatchPoint[]
  matchRecords BeybladeMatchRecord[]

  @@index([userId]) // profile/dashboard/community previews (EXPLAIN: seq scan 2.5 ms → 0.17 ms at 12k rows)
}

model Announcement {
  id        String           @id @default(cuid())
  type      AnnouncementType
  title     String
  content   String
  active    Boolean          @default(true)
  createdBy String
  createdAt DateTime         @default(now())

  creator   User           @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  questions PollQuestion[]
  responses PollResponse[]
}

// One question within a (possibly multi-question) poll. `order` controls
// display order; `type` lets each question independently be free text or
// multiple choice (with its own `options`).
model PollQuestion {
  id             String   @id @default(cuid())
  announcementId String
  order          Int      @default(0)
  text           String
  type           PollType
  options        String[] @default([])
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  answers      PollAnswer[]
}

// One user's full submission to a poll (one row per announcement+user).
model PollResponse {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  validated      Boolean  @default(false)
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  answers      PollAnswer[]

  @@unique([announcementId, userId])
}

// One answer to one question within a PollResponse.
model PollAnswer {
  id              String  @id @default(cuid())
  responseId      String
  questionId      String
  answerText      String?
  selectedOptions String[] @default([])

  response PollResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question PollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model EmailVerifyToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BeybladeMatchRecord {
  id                 String     @id @default(cuid())
  beybladeId         String
  matchId            String
  tournamentId       String
  userId             String
  won                Boolean
  pointsScored       Int        @default(0)
  pointsConceded     Int        @default(0)
  opponentBeybladeId String?
  burstCount         Int        @default(0)
  koCount            Int        @default(0)
  spinFinishCount    Int        @default(0)
  overFinishCount    Int        @default(0)
  extremeFinishCount Int        @default(0)
  createdAt          DateTime   @default(now())

  beyblade   Beyblade   @relation(fields: [beybladeId], references: [id], onDelete: Cascade)
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([beybladeId, matchId])
  @@index([userId])
  @@index([beybladeId])
  @@index([tournamentId])
}

model BeyPart {
  id        String           @id @default(cuid())
  line      BeyPartLine
  category  BeyPartCategory
  name      String
  fullName    String?
  imageUrl    String?
  partType    String?
  weight      Float?
  statAttack  Int?
  statDefense Int?
  statStamina Int?
  statHeight  Int?
  statDash    Int?
  statBurst   Int?
  createdAt   DateTime         @default(now())

  @@unique([line, category, name])
}

// One row per player per round per phase: the persistent guarantee that a
// player never has two participations (two matches, or a bye and a match) in
// the same round — enforced by the unique key even under concurrent requests.
model RoundParticipation {
  id           String   @id @default(cuid())
  tournamentId String
  phase        String   // "SWISS" | "KNOCKOUT"
  round        Int
  userId       String
  matchId      String
  kind         String   // "MATCH" | "BYE"
  createdAt    DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, phase, round, userId])
  @@index([matchId])
}

// One row per generated Swiss round: seed, rules version, bye choice and the
// pairing diagnostics. The unique key also stops a round being generated twice.
model SwissRoundLog {
  id             String   @id @default(cuid())
  tournamentId   String
  round          Int
  rulesVersion   String
  seed           Int?
  byeUserId      String?
  crossings      Int      @default(0)
  optimal        Boolean  @default(true)
  notes          String   @default("")
  exceptionReason String?
  createdById    String?
  createdAt      DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, round])
}

// Audit trail of administrative interventions (repairs, rule exceptions,
// de-duplication): who, why, and a copy of the data before/after.
model TournamentAdminAction {
  id           String   @id @default(cuid())
  tournamentId String
  kind         String
  reason       String
  actorId      String?
  idempotencyKey String? @unique
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@index([tournamentId])
}

// Audit trail of match operations (points, W.O., undo, sides, deck order,
// administrative corrections): author, time, event, match, before/after.
model MatchAuditLog {
  id           String   @id @default(cuid())
  tournamentId String
  matchId      String
  actorId      String
  actorRole    String
  op           String
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([tournamentId, createdAt])
  @@index([matchId])
}

// Monthly ranking of one league (docs/RANKING-MENSAL.md). One row per league and
// month ("AAAA-MM", calendar of America/Sao_Paulo). Created on the first admin
// operation or rules change of that month; a month without a row is open and
// inherits the rules of the latest earlier month that set them.
model RankingPeriod {
  id             String    @id @default(cuid())
  communitySlug  String
  month          String
  // Rules set in this month (inherited by the following months until changed):
  // points per placement (index 0 = 1st) and tiebreak ("NICKNAME" | "WINS").
  // Null = this month did not change the rules.
  pointsTable    Json?
  tiebreak       String?
  // Closing: full archived classification (positions, players as they were,
  // points, wins, losses), rules used, champion, who closed and when.
  standings      Json?
  championUserId String?
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  operations RankingOperation[]

  @@unique([communitySlug, month])
}

// Every admin operation on a monthly ranking. Point adjustments live here, apart
// from the tournament results (which are never changed): the monthly total of a
// player is tournament points + the sum of their adjustments. idempotencyKey
// (request id, plus the player for a whole-month reset) makes a repeated click
// or resent request a no-op.
model RankingOperation {
  id             String   @id @default(cuid())
  periodId       String
  requestId      String
  idempotencyKey String   @unique
  kind           String   // ADD | REMOVE | RESET_PLAYER | RESET_MONTH | RULES | CLOSE
  userId         String?
  points         Int      @default(0) // signed: + added, - removed
  reason         String
  actorId        String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  period RankingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([periodId, userId])
  @@index([requestId])
}
