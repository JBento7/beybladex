generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

enum TournamentFormat {
  ROUND_ROBIN
  GROUPS
  SINGLE_ELIMINATION
  SWISS
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  FINISHED
}

enum FinishType {
  SPIN_FINISH
  OVER_FINISH
  BURST_FINISH
  EXTREME_FINISH
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum DeckType {
  SOLO
  THREE_ON_THREE
}

enum SetStatus {
  IN_PROGRESS
  FINISHED
}

enum AnnouncementType {
  NEWS
  POLL
}

enum PollType {
  TEXT
  CHECKBOX
}

enum BeyPartLine {
  BX
  UX
  CX
  RATCHET
  BIT
  BX_EXPAND
  UX_EXPAND
  CX_EXPAND
}

enum BeyPartCategory {
  BLADE
  RATCHET
  BIT
  LOCK_CHIP
  MAIN_BLADE
  ASSIST_BLADE
  OVER_BLADE
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(PARTICIPANT)
  beyblade      String?
  avatarUrl     String?
  deleted       Boolean  @default(false)
  isGuest       Boolean  @default(false)
  bladerName    String?
  canJudge      Boolean  @default(false)
  featuredBey1  String?
  featuredBey2  String?
  featuredBey3  String?
  createdAt     DateTime @default(now())

  organizedTournaments Tournament[]           @relation("OrganizerTournaments")
  participations       TournamentParticipant[]
  matchesAsPlayer1     Match[]                @relation("Player1Matches")
  matchesAsPlayer2     Match[]                @relation("Player2Matches")
  wonMatches           Match[]                @relation("WinnerMatches")
  judgedMatches        Match[]                @relation("JudgeMatches")
  judgingTournaments   TournamentJudge[]
  matchPoints          MatchPoint[]
  createdInvites       OrganizerInvite[]      @relation("InviteCreator")
  beyblades            Beyblade[]
  wonSets              MatchSet[]             @relation("SetWinner")
  resetTokens          PasswordResetToken[]
  emailVerifyTokens    EmailVerifyToken[]
  emailVerified        Boolean  @default(false)
  announcements        Announcement[]   @relation("AnnouncementCreator")
  pollResponses        PollResponse[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model OrganizerInvite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  createdBy String
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  creator User @relation("InviteCreator", fields: [createdBy], references: [id])
}

model Tournament {
  id              String           @id @default(cuid())
  name            String
  description     String?
  format          TournamentFormat
  status          TournamentStatus @default(DRAFT)
  organizerId     String
  maxParticipants Int?
  startDate       DateTime?
  deckType        DeckType         @default(SOLO)
  prize           String?
  arenas          Int?    @default(1)
  isOfficial      Boolean @default(true)
  isTest          Boolean @default(false)
  setsToWin       Int     @default(2)
  pointsToWinSet  Int     @default(4)
  bannerUrl       String?
  location        String?
  venueName       String?
  address         String?
  entryFee        Float?
  regulation      String?
  registrationDeadline DateTime?
  createdAt       DateTime         @default(now())

  organizer       User                   @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  participants    TournamentParticipant[]
  groups          Group[]
  matches         Match[]
  judges          TournamentJudge[]
  beybladeRecords BeybladeMatchRecord[]
}

model TournamentJudge {
  id           String @id @default(cuid())
  tournamentId String
  userId       String

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  groupId      String?
  totalPoints  Int      @default(0)
  rankingPoints Int     @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  placement    Int?
  beyblade1    String?
  beyblade2    String?
  beyblade3    String?
  hasPaid            Boolean  @default(false)
  beybladeInspected  Boolean  @default(false)
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  group      Group?     @relation(fields: [groupId], references: [id])

  @@unique([tournamentId, userId])
}

model Group {
  id           String @id @default(cuid())
  tournamentId String
  name         String

  tournament   Tournament             @relation(fields: [tournamentId], references: [id])
  participants TournamentParticipant[]
  matches      Match[]
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  player1Id    String
  player2Id    String
  winnerId     String?
  groupId      String?
  judgeId      String?
  round        Int
  bracketPos   Int?
  arena        Int?
  slot         Int?
  status       MatchStatus @default(PENDING)
  isWalkover   Boolean     @default(false)
  isThirdPlace Boolean     @default(false)
  countdownAt  DateTime?
  countdownKey String?
  createdAt    DateTime    @default(now())

  tournament     Tournament            @relation(fields: [tournamentId], references: [id])
  player1        User                  @relation("Player1Matches", fields: [player1Id], references: [id])
  player2        User                  @relation("Player2Matches", fields: [player2Id], references: [id])
  winner         User?                 @relation("WinnerMatches", fields: [winnerId], references: [id])
  judge          User?                 @relation("JudgeMatches", fields: [judgeId], references: [id])
  group          Group?                @relation(fields: [groupId], references: [id])
  points         MatchPoint[]
  sets           MatchSet[]
  beybladeRecords BeybladeMatchRecord[]
  deckOrders     MatchDeckOrder[]
}

model MatchSet {
  id            String    @id @default(cuid())
  matchId       String
  setNumber     Int
  player1Points Int       @default(0)
  player2Points Int       @default(0)
  winnerId      String?
  status        SetStatus @default(IN_PROGRESS)
  createdAt     DateTime  @default(now())

  match   Match        @relation(fields: [matchId], references: [id])
  winner  User?        @relation("SetWinner", fields: [winnerId], references: [id])
  points  MatchPoint[]
}

model MatchPoint {
  id           String     @id @default(cuid())
  matchId      String
  userId       String
  finishType   FinishType
  points       Int
  beybladeUsed String?
  beybladeId   String?
  setId        String?
  createdAt    DateTime   @default(now())

  match     Match     @relation(fields: [matchId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  beyblade  Beyblade? @relation(fields: [beybladeId], references: [id])
  set       MatchSet? @relation(fields: [setId], references: [id])
}

model MatchDeckOrder {
  id         String   @id @default(cuid())
  matchId    String
  setNumber  Int
  userId     String
  cycleIndex Int
  bey1Id     String
  bey2Id     String
  bey3Id     String
  createdAt  DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@unique([matchId, userId, setNumber, cycleIndex])
}

model Beyblade {
  id          String   @id @default(cuid())
  userId      String
  name        String
  beyLine     String?
  blade       String?
  ratchet     String?
  bit         String?
  lockChip    String?
  metalBlade  String?
  assistBlade String?
  overBlade   String?
  model       String?
  wins        Int      @default(0)
  losses      Int      @default(0)
  hiddenFromCommunity Boolean @default(false)
  createdAt   DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id])
  matchPoints  MatchPoint[]
  matchRecords BeybladeMatchRecord[]
}

model Announcement {
  id        String           @id @default(cuid())
  type      AnnouncementType
  title     String
  content   String
  active    Boolean          @default(true)
  createdBy String
  createdAt DateTime         @default(now())

  creator   User           @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  questions PollQuestion[]
  responses PollResponse[]
}

// One question within a (possibly multi-question) poll. `order` controls
// display order; `type` lets each question independently be free text or
// multiple choice (with its own `options`).
model PollQuestion {
  id             String   @id @default(cuid())
  announcementId String
  order          Int      @default(0)
  text           String
  type           PollType
  options        String[] @default([])
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  answers      PollAnswer[]
}

// One user's full submission to a poll (one row per announcement+user).
model PollResponse {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  validated      Boolean  @default(false)
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  answers      PollAnswer[]

  @@unique([announcementId, userId])
}

// One answer to one question within a PollResponse.
model PollAnswer {
  id              String  @id @default(cuid())
  responseId      String
  questionId      String
  answerText      String?
  selectedOptions String[] @default([])

  response PollResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question PollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
}

model EmailVerifyToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BeybladeMatchRecord {
  id                 String     @id @default(cuid())
  beybladeId         String
  matchId            String
  tournamentId       String
  userId             String
  won                Boolean
  pointsScored       Int        @default(0)
  pointsConceded     Int        @default(0)
  opponentBeybladeId String?
  burstCount         Int        @default(0)
  koCount            Int        @default(0)
  spinFinishCount    Int        @default(0)
  overFinishCount    Int        @default(0)
  extremeFinishCount Int        @default(0)
  createdAt          DateTime   @default(now())

  beyblade   Beyblade   @relation(fields: [beybladeId], references: [id], onDelete: Cascade)
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([beybladeId, matchId])
  @@index([userId])
  @@index([beybladeId])
  @@index([tournamentId])
}

model BeyPart {
  id        String           @id @default(cuid())
  line      BeyPartLine
  category  BeyPartCategory
  name      String
  fullName    String?
  imageUrl    String?
  partType    String?
  weight      Float?
  statAttack  Int?
  statDefense Int?
  statStamina Int?
  statHeight  Int?
  statDash    Int?
  statBurst   Int?
  createdAt   DateTime         @default(now())

  @@unique([line, category, name])
}
