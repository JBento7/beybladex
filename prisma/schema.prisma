generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

enum TournamentFormat {
  ROUND_ROBIN
  GROUPS
  SINGLE_ELIMINATION
  SWISS
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  FINISHED
}

enum FinishType {
  SPIN_FINISH
  OVER_FINISH
  BURST_FINISH
  EXTREME_FINISH
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum DeckType {
  SOLO
  THREE_ON_THREE
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(PARTICIPANT)
  beyblade      String?
  createdAt     DateTime @default(now())

  organizedTournaments Tournament[]           @relation("OrganizerTournaments")
  participations       TournamentParticipant[]
  matchesAsPlayer1     Match[]                @relation("Player1Matches")
  matchesAsPlayer2     Match[]                @relation("Player2Matches")
  wonMatches           Match[]                @relation("WinnerMatches")
  matchPoints          MatchPoint[]
  createdInvites       OrganizerInvite[]      @relation("InviteCreator")
}

model OrganizerInvite {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  createdBy String
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  creator User @relation("InviteCreator", fields: [createdBy], references: [id])
}

model Tournament {
  id              String           @id @default(cuid())
  name            String
  description     String?
  format          TournamentFormat
  status          TournamentStatus @default(DRAFT)
  organizerId     String
  maxParticipants Int?
  startDate       DateTime?
  deckType        DeckType         @default(SOLO)
  createdAt       DateTime         @default(now())

  organizer    User                   @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  participants TournamentParticipant[]
  groups       Group[]
  matches      Match[]
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  groupId      String?
  totalPoints  Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  placement    Int?
  beyblade1    String?
  beyblade2    String?
  beyblade3    String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  group      Group?     @relation(fields: [groupId], references: [id])

  @@unique([tournamentId, userId])
}

model Group {
  id           String @id @default(cuid())
  tournamentId String
  name         String

  tournament   Tournament             @relation(fields: [tournamentId], references: [id])
  participants TournamentParticipant[]
  matches      Match[]
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  player1Id    String
  player2Id    String
  winnerId     String?
  groupId      String?
  round        Int
  bracketPos   Int?
  status       MatchStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  tournament Tournament  @relation(fields: [tournamentId], references: [id])
  player1    User        @relation("Player1Matches", fields: [player1Id], references: [id])
  player2    User        @relation("Player2Matches", fields: [player2Id], references: [id])
  winner     User?       @relation("WinnerMatches", fields: [winnerId], references: [id])
  group      Group?      @relation(fields: [groupId], references: [id])
  points     MatchPoint[]
}

model MatchPoint {
  id           String     @id @default(cuid())
  matchId      String
  userId       String
  finishType   FinishType
  points       Int
  beybladeUsed String?
  createdAt    DateTime   @default(now())

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}
